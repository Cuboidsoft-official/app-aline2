# Single source of truth for the backend. The app derives /api and socket URLs automatically.
# Default this to the hosted API for both development and production usage.
BACKEND_ORIGIN=https://api.aline2.com
# Optional overrides if you need a different API or socket host than BACKEND_ORIGIN
API_BASE_URL=
SOCKET_URL=
# Optional public domain used for share links. Defaults to BACKEND_ORIGIN when public.
SHARE_BASE_URL=https://aline2.com

# Google Sign-In
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com

# Gemini AI assistant fallback
GEMINI_API_KEY=

# Calling / WebRTC
# The app reads ICE/TURN server config from the backend call payload.
# No client-side TURN credentials are needed here when the backend is configured correctly.
