{
  "name": "Aline2",
  "version": "2.2.1",
  "private": true,
  "scripts": {
    "postinstall": "node ./scripts/patch-nitro-sound-android.js && node ./scripts/patch-react-native-keep-awake-android.js && node ./scripts/patch-webrtc-event-target-shim.js && node ./scripts/patch-color-matrix-codegen-name.js",
    "android": "react-native run-android --active-arch-only --appId com.aline2.debug",
    "android:dev": "bash ./scripts/run-android-dev.sh",
    "android:staging": "ENVFILE=.env.staging react-native run-android --appId com.aline2.debug",
    "android:staging:apk": "cd android && ENVFILE=.env.staging ./gradlew assembleRelease",
    "android:prod": "ENVFILE=.env.production react-native run-android --appId com.aline2.debug",
    "android:prod:apk": "bash ./scripts/build-android-release.sh apk",
    "android:prod:aab": "bash ./scripts/build-android-release.sh aab",
    "ios": "react-native run-ios",
    "ios:dev": "ENVFILE=.env react-native run-ios",
    "ios:staging": "ENVFILE=.env.staging react-native run-ios",
    "ios:prod": "ENVFILE=.env.production react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "start:dev": "ENVFILE=.env react-native start",
    "start:staging": "ENVFILE=.env.staging react-native start",
    "start:prod": "ENVFILE=.env.production react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test -- --runInBand"
  },
